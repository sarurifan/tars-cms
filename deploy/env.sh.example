# tars-cms 部署环境变量样例
#
# 复制为 deploy/env.sh 后按需修改（env.sh 已被 .gitignore 忽略，不会进仓库）:
#   cp deploy/env.sh.example deploy/env.sh

# ── 数据库（必填）─────────────────────────
export CMS_DB_HOST=172.25.0.2
export CMS_DB_PORT=3306
export CMS_DB_USER=root
export CMS_DB_PASS=CHANGE_ME          # ← 必须修改
export CMS_DB_NAME=tars_cms

# ── 网关地址（默认自动探测本机 IP，亦可显式指定）──
# export CMS_GATEWAY=http://192.168.1.95:8200

# ── tarsnode 节点 IP（默认 172.25.0.5）──
# export CMS_NODE_IP=172.25.0.5

# ── TARS 数据目录（默认 /docker/tars）──
# export CMS_BASE_DIR=/docker/tars
# export CMS_BUILD_DIR=/docker/tars/build/tars-cms

# ── TarsWeb ticket（干净机必填）─────────────
# 获取方法:
#   1. 浏览器打开 TarsWeb: http://<本机IP>:3000
#   2. 登录（默认 admin/admin123）
#   3. F12 → Network → 任一请求参数里的 ticket 值
#   4. 贴在下方，或运行: bash deploy/n00-get-token.sh
# export TARS_TICKET=

# ── TarsWeb 登录账号（n00-get-token.sh 自动登录用，可选）──
# 默认 admin/admin123，与 TarsWeb 后台 admin 账号一致。
# 支持通过环境变量覆盖：export TARS_USER=<用户> TARS_PASS=<密码>，或 --user/--pass 参数，
# 优先级：--user/--pass > 环境变量 > env.sh 此处配置 > 默认 admin/admin123。
# export TARS_USER=admin
# export TARS_PASS=admin123

# ── 后台管理账号（可选）─────────────────────
export CMS_ADMIN_USER=admin
export CMS_ADMIN_PASS=
