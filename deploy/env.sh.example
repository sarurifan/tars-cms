# tars-cms 部署环境变量样例
#
# 复制为 deploy/env.sh 后按需修改（env.sh 已被 .gitignore 忽略，不会进仓库）:
#   cp deploy/env.sh.example deploy/env.sh

# ── 数据库（必填）─────────────────────────
export CMS_DB_HOST=172.25.0.2
export CMS_DB_PORT=3306
export CMS_DB_USER=root
export CMS_DB_PASS=CHANGE_ME          # ← 必须修改
export CMS_DB_NAME=tars_cms

# ── 网关 ────────────────────────────────
export CMS_GATEWAY=http://192.168.1.95:8200

# ── tars-node 容器节点 IP（可选，留空自动探测）──
# export CMS_NODE_IP=172.25.0.5

# ── 后台管理账号（可选）─────────────────────
export CMS_ADMIN_USER=admin
export CMS_ADMIN_PASS=

# ── TarsWeb ticket（可选，留空从既有脚本读取）──
# export TARS_TICKET=
