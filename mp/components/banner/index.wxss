/* components/banner/index.wxss — 轮播图样式 */
.banner-swiper {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-item {
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  background-color: #5778ff;
  position: relative;
  display: flex;
  align-items: flex-end;
}

.banner-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent 60%);
}

.banner-text {
  position: relative;
  padding: 24rpx;
  width: 100%;
}

.banner-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.banner-summary {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}
