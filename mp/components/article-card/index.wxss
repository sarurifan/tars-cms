/* components/article-card/index.wxss — 文章卡片样式 */
.article-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-cover {
  width: 100%;
  height: 320rpx;
  background-size: cover;
  background-position: center;
  position: relative;
}

.card-cover-placeholder {
  background: linear-gradient(135deg, #5778ff 0%, #7ba3ff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.cover-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.3), transparent);
}

.card-body {
  padding: 20rpx 24rpx 24rpx;
}

.card-badges {
  display: flex;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.badge-top {
  background: #fde8e8;
  color: #e74c3c;
}

.badge-focus {
  background: #e8f0fe;
  color: #5778ff;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  line-height: 1.4;
}

.card-summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7f8c8d;
}

.card-meta {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 22rpx;
  color: #95a5a6;
}

.meta-cat {
  background: #f0f2f5;
  color: #5778ff;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
