/* pages/profile/index.wxss — 我的页样式 */
.profile-page {
  padding: 24rpx;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #5778ff 0%, #7ba3ff 100%);
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
}

.user-avatar-placeholder {
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
}

.user-info {
  flex: 1;
}

.user-name {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
}

.user-sub {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}

/* 登录卡片 */
.login-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 56rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.login-icon {
  font-size: 88rpx;
}

.login-title {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #2c3e50;
}

.login-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #95a5a6;
}

.btn-login {
  margin-top: 36rpx;
  width: 80%;
}

.login-tip {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #e67e22;
  line-height: 1.6;
}

/* 菜单 */
.menu-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-bottom: 2rpx solid #f0f2f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 28rpx;
  color: #2c3e50;
}

.menu-danger {
  color: #e74c3c;
}

.menu-arrow {
  color: #b0b8c4;
  font-size: 34rpx;
}

/* 页脚 */
.demo-note {
  text-align: center;
  padding: 40rpx 0;
  font-size: 22rpx;
  color: #b0b8c4;
}
