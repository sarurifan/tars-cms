/* pages/home/index.wxss — 首页样式 */
.home-page {
  padding: 24rpx;
}

/* 顶部介绍条 */
.intro-bar {
  background: linear-gradient(135deg, #5778ff 0%, #7ba3ff 100%);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
}

.intro-title {
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.intro-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
  line-height: 1.5;
}

/* 分类快捷入口 */
.category-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 24rpx 0 8rpx;
}

.nav-chip {
  background: #ffffff;
  color: #5778ff;
  font-size: 24rpx;
  padding: 10rpx 26rpx;
  border-radius: 30rpx;
  border: 2rpx solid #e3e9ff;
}

/* 区块 */
.section {
  margin-top: 32rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
}

.section-more {
  font-size: 24rpx;
  color: #5778ff;
}

.loading {
  text-align: center;
  padding: 60rpx 0;
}
