/* pages/category/index.wxss — 分类页样式 */
.category-page {
  padding: 24rpx;
}

/* 分类筛选（横向滚动） */
.category-filter {
  display: flex;
  gap: 14rpx;
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.filter-chip {
  display: inline-block;
  background: #ffffff;
  color: #2c3e50;
  font-size: 24rpx;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  border: 2rpx solid #e9ecef;
  flex-shrink: 0;
}

.filter-chip.active {
  background: #5778ff;
  color: #ffffff;
  border-color: #5778ff;
}

/* 分页 */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-top: 32rpx;
  padding-bottom: 40rpx;
}

.btn-page {
  background: #ffffff;
  color: #5778ff;
  border: 2rpx solid #5778ff;
  border-radius: 8rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
  line-height: 2.6;
  margin: 0;
}

.btn-page::after {
  border: none;
}

.btn-page[disabled] {
  background: #f0f2f5;
  color: #b0b8c4;
  border-color: #e9ecef;
}

.page-info {
  font-size: 24rpx;
  color: #7f8c8d;
}

.btn-home {
  margin-top: 32rpx;
  display: inline-block;
}
